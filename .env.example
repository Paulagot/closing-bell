# ── Solana RPC ──
# Free: https://api.mainnet-beta.solana.com (rate limited)
# Better: sign up at helius.dev or quicknode.com for a free key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Jupiter API ──
# lite-api.jup.ag works without a key (rate limited)
# For production: get a key at jup.ag/developers
JUPITER_API_URL=https://lite-api.jup.ag

# ── Stock Reference Prices ──
# Finnhub: free key at finnhub.io (60 calls/min)
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── Optional: better RPC for wallet reads ──
# HELIUS_API_KEY=your_helius_key_here
